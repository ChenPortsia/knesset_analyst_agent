# Copy to .env (make up does this) and change the passwords.
# Host-side defaults: native runs (uv run knesset ...) reach the Dockerized services on localhost.
# Inside compose, DB_HOST and PHOENIX_URL are overridden to the service names.

# Postgres
POSTGRES_PASSWORD=change-me-postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knesset
ETL_PASSWORD=change-me-etl
AGENT_RO_PASSWORD=change-me-agent
UI_APP_PASSWORD=change-me-ui
PHOENIX_DB_PASSWORD=change-me-phoenix

# Tracing (Phoenix UI + OTLP over HTTP)
PHOENIX_URL=http://localhost:6006

# knesset.gov.il: parallel requests (halved automatically on firewall answers 473/481)
ODATA_CONCURRENCY=8

# Word extraction: LibreOffice binary and parallel conversions
SOFFICE=soffice
SOFFICE_WORKERS=4

# LLMs (Anthropic). Never commit the key; .env is gitignored.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-haiku-5-5
AGENT_ORCHESTRATOR_MODEL=claude-opus-5-5
AGENT_SUMMARIZER_MODEL=claude-opus-5-5
AGENT_ANALYST_MODEL=claude-sonnet-5-5
AGENT_RESEARCHER_MODEL=claude-sonnet-5-5
AGENT_VERIFIER_MODEL=claude-sonnet-5-5

# Logging
LOG_DIR=logs
LOG_RETENTION_DAYS=90

# Dev scope for text / embedding / enrichment steps
SCOPE_KNESSETS=25,26

# Compute device: auto | mps | cuda | cpu
DEVICE=auto
