# Copy to .env (make up does this) and change the passwords.
# Host-side defaults: native runs (uv run knesset ...) reach the Dockerized services on localhost.
# Inside compose, DB_HOST and PHOENIX_URL are overridden to the service names.

# Postgres
POSTGRES_PASSWORD=change-me-postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knesset
ETL_PASSWORD=change-me-etl
AGENT_RO_PASSWORD=change-me-agent
UI_APP_PASSWORD=change-me-ui
PHOENIX_DB_PASSWORD=change-me-phoenix

# Tracing (Phoenix UI + OTLP over HTTP)
PHOENIX_URL=http://localhost:6006

# knesset.gov.il: parallel requests (halved automatically on firewall answers 473/481)
ODATA_CONCURRENCY=8

# Word extraction: LibreOffice binary and parallel conversions
SOFFICE=soffice
SOFFICE_WORKERS=4

# LLMs (Anthropic). Never commit the key; .env is gitignored.
ANTHROPIC_API_KEY=
# optional: only for OpenAI models in the eval matrix (eval/configs.yaml)
OPENAI_API_KEY=
ENRICH_MODEL=claude-haiku-5-5
TOPIC_BUDGET_USD=10
AGENT_ORCHESTRATOR_MODEL=claude-sonnet-5-5
AGENT_SUMMARIZER_MODEL=claude-haiku-5-5
AGENT_ANALYST_MODEL=claude-haiku-5-5
AGENT_RESEARCHER_MODEL=claude-haiku-5-5
AGENT_VERIFIER_MODEL=claude-haiku-5-5
# Per-question limits for the agents (all agents together)
AGENT_MAX_COST_USD=0.5
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_S=150

# Logging
LOG_DIR=logs
LOG_RETENTION_DAYS=90

# Dev scope for text / embedding / enrichment steps
SCOPE_KNESSETS=25,26

# Compute device: auto | mps | cuda | cpu
DEVICE=auto

# Postgres memory (docker-compose db): the vector index must fit in shared buffers
DB_SHARED_BUFFERS=3GB
DB_EFFECTIVE_CACHE=5GB

# Langfuse Cloud (optional): the same traces as Phoenix. Leave empty to send nothing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
